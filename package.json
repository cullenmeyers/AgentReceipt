{
  "name": "agentreceipt",
  "version": "0.1.0",
  "description": "Portable signed attestations for consequential agent actions crossing trust boundaries.",
  "homepage": "https://boundaryattest.com",
  "type": "module",
  "private": true,
  "license": "MIT",
  "bin": {
    "agentreceipt": "dist/src/index.js"
  },
  "exports": {
    ".": "./dist/src/public.js"
  },
  "types": "./dist/src/public.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "setup": "node dist/src/index.js setup",
    "demo": "node dist/src/index.js demo",
    "verify": "node dist/src/index.js verify",
    "chain": "node dist/src/index.js chain",
    "chain:retained": "node dist/src/index.js chain:retained",
    "prune": "node dist/src/index.js prune",
    "example:wrap": "node dist/examples/wrap-fake-tool.js",
    "example:sink": "node dist/examples/custom-sink-demo.js",
    "example:mcp": "node dist/examples/mcp-style-demo.js",
    "example:mcp-real": "node dist/examples/mcp-real-demo.js",
    "example:mcp-server": "node dist/examples/mcp-server-receipt-demo.js",
    "example:trust-boundary": "node dist/examples/trust-boundary-demo.js",
    "example:intergrax-poc": "node dist/examples/intergrax-poc/run.js",
    "example:proof-kit": "node dist/examples/proof-kit/verify-proof-kit.js",
    "example:interop-v0.1": "node dist/examples/interop-v0.1/verify-vectors.js",
    "example:interop-code-engine": "node dist/examples/interop-v0.1/verify-code-engine.js",
    "example:python-interop-v0.1": "python3 examples/python-interop-v0.1/verify_receipt.py examples/python-interop-v0.1/sample_receipt.json examples/python-interop-v0.1/demo-public-key.pem && python3 examples/python-interop-v0.1/sign_receipt.py examples/python-interop-v0.1/sample_claim.json examples/python-interop-v0.1/demo-private-key.pem --output /tmp/boundaryattest-python-interop-v0.1.json && python3 examples/python-interop-v0.1/verify_receipt.py /tmp/boundaryattest-python-interop-v0.1.json examples/python-interop-v0.1/demo-public-key.pem",
    "example:ckg-agentforce-verify-source-v0.1": "node dist/examples/ckg-agentforce-verify-source-v0.1/verify-fixtures.js",
    "example:trustmcp-post-scan": "node dist/examples/trustmcp-post-scan-receipt/trustmcp-post-scan-receipt.js",
    "example:faf-mcp-handoff-v0.1": "node dist/examples/faf-mcp-handoff-v0.1/generate-faf-examples.js",
    "example:benchmark-result-public-v0.1": "node dist/examples/benchmark-result-public-v0.1/verify-canonical-artifact.js",
    "reset:demo": "node scripts/reset-demo.mjs",
    "reset:all": "node scripts/reset-all.mjs",
    "demo:clean": "npm run reset:demo && npm run build && npm run example:mcp-real && npm run chain"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  }
}
